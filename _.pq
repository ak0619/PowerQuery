(input as nullable text) as nullable text =>
let
    // null の場合は null を返す
    Source = input,

    // 全角カタカナ → 半角カタカナの対応表
    KanaKeys = {
        "ア","イ","ウ","エ","オ",
        "カ","キ","ク","ケ","コ",
        "サ","シ","ス","セ","ソ",
        "タ","チ","ツ","テ","ト",
        "ナ","ニ","ヌ","ネ","ノ",
        "ハ","ヒ","フ","ヘ","ホ",
        "マ","ミ","ム","メ","モ",
        "ヤ","ユ","ヨ",
        "ラ","リ","ル","レ","ロ",
        "ワ","ヲ","ン",
        "ァ","ィ","ゥ","ェ","ォ",
        "ャ","ュ","ョ","ッ",
        "ー",
        "ガ","ギ","グ","ゲ","ゴ",
        "ザ","ジ","ズ","ゼ","ゾ",
        "ダ","ヂ","ヅ","デ","ド",
        "バ","ビ","ブ","ベ","ボ",
        "パ","ピ","プ","ペ","ポ",
        "ヴ",
        "ヷ","ヸ","ヹ","ヺ",
        "。","、","・","「","」","゛","゜"
    },

    KanaValues = {
        "ｱ","ｲ","ｳ","ｴ","ｵ",
        "ｶ","ｷ","ｸ","ｹ","ｺ",
        "ｻ","ｼ","ｽ","ｾ","ｿ",
        "ﾀ","ﾁ","ﾂ","ﾃ","ﾄ",
        "ﾅ","ﾆ","ﾇ","ﾈ","ﾉ",
        "ﾊ","ﾋ","ﾌ","ﾍ","ﾎ",
        "ﾏ","ﾐ","ﾑ","ﾒ","ﾓ",
        "ﾔ","ﾕ","ﾖ",
        "ﾗ","ﾘ","ﾙ","ﾚ","ﾛ",
        "ﾜ","ｦ","ﾝ",
        "ｧ","ｨ","ｩ","ｪ","ｫ",
        "ｬ","ｭ","ｮ","ｯ",
        "ｰ",
        "ｶﾞ","ｷﾞ","ｸﾞ","ｹﾞ","ｺﾞ",
        "ｻﾞ","ｼﾞ","ｽﾞ","ｾﾞ","ｿﾞ",
        "ﾀﾞ","ﾁﾞ","ﾂﾞ","ﾃﾞ","ﾄﾞ",
        "ﾊﾞ","ﾋﾞ","ﾌﾞ","ﾍﾞ","ﾎﾞ",
        "ﾊﾟ","ﾋﾟ","ﾌﾟ","ﾍﾟ","ﾎﾟ",
        "ｳﾞ",
        "ﾜﾞ","ｲﾞ","ｴﾞ","ｦﾞ",
        "｡","､","･","｢","｣","ﾞ","ﾟ"
    },

    KanaMap = Record.FromList(KanaValues, KanaKeys),

    // 1文字ずつ変換
    Converted =
        if Source = null then
            null
        else
            Text.Combine(
                List.Transform(
                    Text.ToList(Source),
                    each
                        let
                            c = _,
                            n = Character.ToNumber(c)
                        in
                            // 全角スペース → 半角スペース
                            if c = "　" then
                                " "

                            // 全角英数字・全角ASCII記号
                            // ＡＢＣ１２３！＃％ などを ABC123!#% に変換
                            else if n >= 65281 and n <= 65374 then
                                Character.FromNumber(n - 65248)

                            // 全角カタカナ・句読点など
                            else
                                Record.FieldOrDefault(KanaMap, c, c)
                )
            )
in
    Converted
