let
    // ══════════════════════════════════════════════════════════════════
    //  プライベートヘルパー
    // ══════════════════════════════════════════════════════════════════

    // 1文字ずつ fromChars 上の位置を検索し toChars の同位置文字に置換（1:1 マッピング専用）
    charMap = (s as text, fromChars as text, toChars as text) as text =>
        Text.Combine(
            List.Transform(
                Text.ToList(s),
                each
                    let pos = Text.PositionOf(fromChars, _)
                    in if pos >= 0 then Text.At(toChars, pos) else _
            )
        ),

    // {変換前, 変換後} ペアのリストを左から順に Text.Replace で適用
    applyPairs = (s as text, pairs as list) as text =>
        List.Accumulate(pairs, s, (acc, pair) => Text.Replace(acc, pair{0}, pair{1})),

    // ══════════════════════════════════════════════════════════════════
    //  定数（クエリスコープで一度だけ評価）
    // ══════════════════════════════════════════════════════════════════

    // 全角英数記号（先頭: U+3000 全角スペース、以降 U+FF01–FF5E）→ 対応 ASCII（U+0020–007E）
    // 各文字の位置が 1:1 対応するため charMap で変換可能。計 95 文字
    FULL_ASCII =
        "　！＂＃＄％＆＇（）＊＋，－．／"    // 16文字（全角スペース ～ ／）
        & "０１２３４５６７８９：；＜＝＞？＠"  // 17文字（０ ～ ＠）
        & "ＡＢＣＤＥＦＧＨＩＪＫＬＭＮＯＰＱＲＳＴＵＶＷＸＹＺ"  // 26文字
        & "［＼］＾＿｀"                         //  6文字
        & "ａｂｃｄｅｆｇｈｉｊｋｌｍｎｏｐｑｒｓｔｕｖｗｘｙｚ"  // 26文字
        & "｛｜｝～",                             //  4文字

    HALF_ASCII =
        " !""#$%&'()*+,-./"                       // 16文字（半角スペース ～ /）
        & "0123456789:;<=>?@"                      // 17文字（0 ～ @）
        & "ABCDEFGHIJKLMNOPQRSTUVWXYZ"             // 26文字
        & "[\]^_`"                                 //  6文字
        & "abcdefghijklmnopqrstuvwxyz"             // 26文字
        & "{|}~",                                  //  4文字

    // 全角ダッシュ類 → 半角ハイフン変換ペア
    // ※ ー（カタカナ長音符 U+30FC）を含む
    //   KanaMode="toHalf" との併用時は FullWidthDash=false を推奨
    DASH_PAIRS = {
        {"－", "-"}, {"―", "-"}, {"─", "-"},
        {"‐", "-"}, {"–", "-"}, {"ー", "-"}
    },

    // 全角カナ → 半角カナ
    // ！順序重要: 濁音・半濁音（2文字変換）を清音より先に配置すること
    KANA_FULL_TO_HALF = {
        // 濁音
        {"ガ","ｶﾞ"}, {"ギ","ｷﾞ"}, {"グ","ｸﾞ"}, {"ゲ","ｹﾞ"}, {"ゴ","ｺﾞ"},
        {"ザ","ｻﾞ"}, {"ジ","ｼﾞ"}, {"ズ","ｽﾞ"}, {"ゼ","ｾﾞ"}, {"ゾ","ｿﾞ"},
        {"ダ","ﾀﾞ"}, {"ヂ","ﾁﾞ"}, {"ヅ","ﾂﾞ"}, {"デ","ﾃﾞ"}, {"ド","ﾄﾞ"},
        {"バ","ﾊﾞ"}, {"ビ","ﾋﾞ"}, {"ブ","ﾌﾞ"}, {"ベ","ﾍﾞ"}, {"ボ","ﾎﾞ"},
        {"ヴ","ｳﾞ"},
        // 半濁音
        {"パ","ﾊﾟ"}, {"ピ","ﾋﾟ"}, {"プ","ﾌﾟ"}, {"ペ","ﾍﾟ"}, {"ポ","ﾎﾟ"},
        // 清音・小文字
        {"ァ","ｧ"}, {"ア","ｱ"}, {"ィ","ｨ"}, {"イ","ｲ"}, {"ゥ","ｩ"},
        {"ウ","ｳ"}, {"ェ","ｪ"}, {"エ","ｴ"}, {"ォ","ｫ"}, {"オ","ｵ"},
        {"カ","ｶ"}, {"キ","ｷ"}, {"ク","ｸ"}, {"ケ","ｹ"}, {"コ","ｺ"},
        {"サ","ｻ"}, {"シ","ｼ"}, {"ス","ｽ"}, {"セ","ｾ"}, {"ソ","ｿ"},
        {"タ","ﾀ"}, {"チ","ﾁ"}, {"ッ","ｯ"}, {"ツ","ﾂ"}, {"テ","ﾃ"}, {"ト","ﾄ"},
        {"ナ","ﾅ"}, {"ニ","ﾆ"}, {"ヌ","ﾇ"}, {"ネ","ﾈ"}, {"ノ","ﾉ"},
        {"ハ","ﾊ"}, {"ヒ","ﾋ"}, {"フ","ﾌ"}, {"ヘ","ﾍ"}, {"ホ","ﾎ"},
        {"マ","ﾏ"}, {"ミ","ﾐ"}, {"ム","ﾑ"}, {"メ","ﾒ"}, {"モ","ﾓ"},
        {"ャ","ｬ"}, {"ヤ","ﾔ"}, {"ュ","ｭ"}, {"ユ","ﾕ"}, {"ョ","ｮ"}, {"ヨ","ﾖ"},
        {"ラ","ﾗ"}, {"リ","ﾘ"}, {"ル","ﾙ"}, {"レ","ﾚ"}, {"ロ","ﾛ"},
        {"ワ","ﾜ"}, {"ヲ","ｦ"}, {"ン","ﾝ"},
        {"ー","ｰ"},
        {"゛","ﾞ"}, {"゜","ﾟ"}
    },

    // 半角カナ → 全角カナ
    // ！順序重要: 2文字ペア（ｶﾞ等）を単文字より先に配置すること
    KANA_HALF_TO_FULL = {
        // 濁音ペア
        {"ｶﾞ","ガ"}, {"ｷﾞ","ギ"}, {"ｸﾞ","グ"}, {"ｹﾞ","ゲ"}, {"ｺﾞ","ゴ"},
        {"ｻﾞ","ザ"}, {"ｼﾞ","ジ"}, {"ｽﾞ","ズ"}, {"ｾﾞ","ゼ"}, {"ｿﾞ","ゾ"},
        {"ﾀﾞ","ダ"}, {"ﾁﾞ","ヂ"}, {"ﾂﾞ","ヅ"}, {"ﾃﾞ","デ"}, {"ﾄﾞ","ド"},
        {"ﾊﾞ","バ"}, {"ﾋﾞ","ビ"}, {"ﾌﾞ","ブ"}, {"ﾍﾞ","ベ"}, {"ﾎﾞ","ボ"},
        {"ｳﾞ","ヴ"},
        // 半濁音ペア
        {"ﾊﾟ","パ"}, {"ﾋﾟ","ピ"}, {"ﾌﾟ","プ"}, {"ﾍﾟ","ペ"}, {"ﾎﾟ","ポ"},
        // 清音・小文字
        {"ｧ","ァ"}, {"ｱ","ア"}, {"ｨ","ィ"}, {"ｲ","イ"}, {"ｩ","ゥ"},
        {"ｳ","ウ"}, {"ｪ","ェ"}, {"ｴ","エ"}, {"ｫ","ォ"}, {"ｵ","オ"},
        {"ｶ","カ"}, {"ｷ","キ"}, {"ｸ","ク"}, {"ｹ","ケ"}, {"ｺ","コ"},
        {"ｻ","サ"}, {"ｼ","シ"}, {"ｽ","ス"}, {"ｾ","セ"}, {"ｿ","ソ"},
        {"ﾀ","タ"}, {"ﾁ","チ"}, {"ｯ","ッ"}, {"ﾂ","ツ"}, {"ﾃ","テ"}, {"ﾄ","ト"},
        {"ﾅ","ナ"}, {"ﾆ","ニ"}, {"ﾇ","ヌ"}, {"ﾈ","ネ"}, {"ﾉ","ノ"},
        {"ﾊ","ハ"}, {"ﾋ","ヒ"}, {"ﾌ","フ"}, {"ﾍ","ヘ"}, {"ﾎ","ホ"},
        {"ﾏ","マ"}, {"ﾐ","ミ"}, {"ﾑ","ム"}, {"ﾒ","メ"}, {"ﾓ","モ"},
        {"ｬ","ャ"}, {"ﾔ","ヤ"}, {"ｭ","ュ"}, {"ﾕ","ユ"}, {"ｮ","ョ"}, {"ﾖ","ヨ"},
        {"ﾗ","ラ"}, {"ﾘ","リ"}, {"ﾙ","ル"}, {"ﾚ","レ"}, {"ﾛ","ロ"},
        {"ﾜ","ワ"}, {"ｦ","ヲ"}, {"ﾝ","ン"},
        {"ｰ","ー"},
        {"ﾞ","゛"}, {"ﾟ","゜"}
    },

    // ══════════════════════════════════════════════════════════════════
    //  メイン関数
    // ══════════════════════════════════════════════════════════════════
    fnNormalize = (
        text             as text,
        optional replacementTable as nullable table,  // 列構成: {変換前, 変換後}（インデックス 0, 1）
        optional inlineRules      as nullable list,   // { {"変換前","変換後"}, ... }
        optional options          as nullable record
    ) as text =>
    let
        opt = Record.Combine({
            [
                FullWidthToHalfWidth = true,   // 全角英数記号・全角スペース → 半角
                FullWidthSpace       = true,   // 全角スペース → 半角（FullWidthToHalfWidth=false 時のみ有効）
                TrimSpaces           = true,   // 前後の空白除去
                NormalizeSpaces      = true,   // 連続空白 → 単一スペース
                ToLower              = false,  // 大文字 → 小文字
                FullWidthDash        = true,   // 全角ダッシュ類 → ハイフン（ー含む）
                KanaMode             = "none"  // "toHalf" | "toFull" | "none"
            ],
            if options = null then [] else options
        }),

        // Step 1: 全角英数記号 / 全角スペース → 半角
        //   FullWidthToHalfWidth=true  → FULL_ASCII に全角スペースを含むため FullWidthSpace は不要
        //   FullWidthToHalfWidth=false → FullWidthSpace=true の場合のみ全角スペースを変換
        s1 = if opt[FullWidthToHalfWidth] then charMap(text, FULL_ASCII, HALF_ASCII)
             else if opt[FullWidthSpace]   then Text.Replace(text, "　", " ")
             else text,

        // Step 2: 全角ダッシュ類 → 半角ハイフン
        s2 = if opt[FullWidthDash] then applyPairs(s1, DASH_PAIRS) else s1,

        // Step 3: カナ変換
        s3 = if      opt[KanaMode] = "toHalf" then applyPairs(s2, KANA_FULL_TO_HALF)
             else if opt[KanaMode] = "toFull"  then applyPairs(s2, KANA_HALF_TO_FULL)
             else s2,

        // Step 4: 大文字 → 小文字
        s4 = if opt[ToLower] then Text.Lower(s3) else s3,

        // Step 5: 前後トリム
        s5 = if opt[TrimSpaces] then Text.Trim(s4) else s4,

        // Step 6: 連続スペース → 単一スペース
        s6 = if opt[NormalizeSpaces]
             then Text.Combine(List.Select(Text.Split(s5, " "), each _ <> ""), " ")
             else s5,

        // Step 7: インラインルール適用
        s7 = if inlineRules = null then s6 else applyPairs(s6, inlineRules),

        // Step 8: テーブルルール適用（列インデックス 0=変換前, 1=変換後）
        s8 = if replacementTable = null then s7
             else applyPairs(s7, Table.ToRows(replacementTable))

    in s8

in fnNormalize
